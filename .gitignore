# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Stockfish binary (platform-specific, use STOCKFISH_PATH env var instead)
stockfish-windows-x86-64-avx2.exe

# Local dev SQLite database (no migration tooling yet -- schema changes
# during development mean dropping and recreating this file; see app/db.py)
*.db

# Node
web/node_modules
web/dist

# Claude Code local settings (machine-specific tool permissions, not shared)
.claude/settings.local.json

# Local runtime config -- may hold endpoints/keys. .env.example is the
# committed template; the real .env never is.
.env

# Machine-specific compose additions. Compose merges this automatically
# when present.
docker-compose.override.yml

# Downloaded model weights (~9GB). Scoped to .cache only -- the compose
# files beside it are tracked, and docker-compose.yml's include: breaks
# without them.
local_llms/.cache/
