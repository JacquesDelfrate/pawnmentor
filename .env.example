# Copy to .env only if you need to override a default. `docker compose up
# --build -d` works with no .env at all -- STOCKFISH_PATH, DATABASE_URL and
# the vLLM wiring are already set in docker-compose.yml.

# Which local LLM to run. Copy local_llms/docker-compose-qwen3-14b.yaml,
# edit the image/command, and point this at it to try a different model.
# Keep the service named `vllm` or override VLLM_BASE_URL to match.
# LLM_COMPOSE_FILE=./local_llms/docker-compose-qwen3-14b.yaml

# Where the ~9GB of model weights live on the host. Point this at an
# existing HuggingFace cache to avoid downloading them again.
# HF_CACHE_DIR=./local_llms/.cache/huggingface

# Only needed to bypass the included `vllm` service and use a server hosted
# elsewhere. For one running on the host machine rather than in compose,
# use http://host.docker.internal:<port>/v1
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# Stockfish processes held open for analysis.
# ENGINE_POOL_SIZE=2
