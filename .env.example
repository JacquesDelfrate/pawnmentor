# Copy to .env and fill in before running `docker compose up`.
# STOCKFISH_PATH and DATABASE_URL are already set inside docker-compose.yml
# for the containerized backend -- nothing to configure for those here.

# Reachable from inside the backend container. If vLLM runs on your host
# machine, use http://host.docker.internal:<port>/v1
VLLM_BASE_URL=http://host.docker.internal:8000/v1

# Whatever model id vLLM was launched with.
VLLM_MODEL=Qwen/Qwen3-8B-Instruct
